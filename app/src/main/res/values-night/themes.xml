<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème principal en mode sombre : fond sombre dès l'ouverture -->
    <style name="Theme.Mizan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mizan_night</item>
    </style>

    <style name="Theme.Mizan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mizan_emerald</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Mizan</item>
    </style>
</resources>
